{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "novaproxy",
  "main": "worker.js",
  "compatibility_date": "2026-07-30",
  "compatibility_flags": ["nodejs_compat"],
  "d1_databases": [
    { "binding": "DB","database_id": "0981dd10-2fd9-45c8-851c-21f7c6d02368","database_name": "novaproxy" }
  ],
  "kv_namespaces": [
    { "binding": "KV","id": "e2b03757146341fc90c72b4b689f076b" }
  ],
  "workers_dev": true,
  "preview_urls": true,
  "observability": {
    "enabled": true,
    "logs": {
      "enabled": true,
      "head_sampling_rate": 1,
      "invocation_logs": true
    },
    "traces": {
      "enabled": true,
      "head_sampling_rate": 0.01
    }
  }
}
